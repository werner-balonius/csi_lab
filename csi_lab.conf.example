# csi_lab 本地配置示例
#
# 复制为 csi_lab.conf 后按自己的环境修改。
# csi_lab.conf 不入库（见 .gitignore），因为它含内网拓扑信息。
#
#   cp csi_lab.conf.example csi_lab.conf
#
# 注意：节点名（node1/node2/node3）是 ~/.ssh/config 里的 Host 别名，
# 不是主机名。见 README 的「SSH 配置」一节。

# ---- 节点角色 ----
TX_NODE=node2        # 发射端
RX_A=node1           # 接收端 A（对齐时作参考端）
RX_B=node3           # 接收端 B

# ---- 相机 ----
# 留空则不采深度相机（也就没有姿态真值）
# CAM_HOST=node1

# ---- 路径 ----
RESULTS="$HOME/csi_results"
PYTHON_BIN="$HOME/csienv/bin/python"

# ---- 时序 ----
RX_MARGIN=15         # 接收端比发射端多跑的秒数
TX_MARGIN=5          # 覆盖 PicoScenes 启动开销
READY_TIMEOUT=60
CAM_READY_TIMEOUT=45
BATCH_GAP=10         # 批量采集两组之间的准备时间

# ---- 其他 ----
NO_RESTORE=0         # 1 = 采集后不恢复 Wi-Fi

# ---- 可选：本地语音动作协议 ----
# LOCAL_VOICE_PROTOCOL=action_5_20_10
# LOCAL_VOICE_ACTION=walk_link2  # walk_link2 / arm_wave / leg_lift / sit_to_stand

# ---- 可选：固定布局元数据 ----
# 8-11 pilot 布局（5m 等边三角，带相机）
# LAYOUT_ID=5m_equilateral_20260811
# NODE1_XYZ_M="-5.000 0.000 1.000"
# NODE2_XYZ_M="-2.500 4.330 1.000"
# NODE3_XYZ_M="0.000 0.000 1.000"
# CAMERA_XYZ_M="0.000 0.000 1.000"
# CAMERA_ORIENTATION="from node3 toward node2"
# LAYOUT_REFERENCE="docs/experiments/20260811_pilot/layout_no_chair.md"

# 8-24 空间分辨能力判据实验布局（3m 直线链路，不采相机）
#
#   node2(Tx) ●━━━━━━━━━━━━━━━━━● node1(Rx1)
#             0  A(.75) B(1.5) C(2.25) 3m
#                      ● node3(Rx2) 链路外 3m
#
# 链路须 >= 2m：三点等分时间距 = D/4，而菲涅尔直径 ∝ √D，
#   1m -> 间距 0.25 < 菲涅尔 0.35（重叠）；3m -> 0.75 > 0.61（可分）
#   另需间距 > 躯干宽 0.4-0.5m，否则相邻两点身体重合。
# node3 须在链路外 3m：到 A/B/C 距离 3.09/3.00/3.09m（差异 3%），
#   若仅 1m 则为 1.25/1.00/1.25m（差异 21.4%），空间对照失真。
#
# LAYOUT_ID=3m_inline_20260824
# NODE1_XYZ_M="3.000 0.000 1.000"
# NODE2_XYZ_M="0.000 0.000 1.000"
# NODE3_XYZ_M="1.500 3.000 1.000"
# LAYOUT_REFERENCE="docs/experiments/20260821_spatial_resolvability_design.md"
# BATCH_GAP=25    # 判据实验需走位站稳，默认 10s 偏紧

# 座椅布局时再设置；无座椅布局留空。
# CHAIR_CENTER_XYZ_M="-1.250 2.165 0.500"
# CHAIR_ORIENTATION="seat front toward node3 camera; back toward node2"
# CHAIR_SEAT_HEIGHT_M="0.500"
# CHAIR_DESCRIPTION="teal fabric armless office chair; black five-caster swivel base"
# CHAIR_STABILITY="five casters immobilized and swivel orientation fixed"
